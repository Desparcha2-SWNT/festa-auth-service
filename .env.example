# Variables de auth-service. Con docker compose se toman de festa-infra/.env.
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/auth_db
DB_USER=auth_svc
DB_PASSWORD=change-me-auth
AMQP_URL=amqp://festa:change-me-rabbit@localhost:5672

JWT_ISSUER=festa-auth
JWT_PRIVATE_KEY_PATH=../festa-infra/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../festa-infra/secrets/jwt_public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# 32 bytes en base64 (openssl rand -base64 32). Obligatoria.
PII_ENCRYPTION_KEY=

# Client IDs de Google (Android, iOS, web) separados por coma. Vacío = login con Google deshabilitado.
GOOGLE_CLIENT_IDS=
# Dominio permitido en el piloto (acepta subdominios). Vacío = cualquiera.
ALLOWED_EMAIL_DOMAIN=escuelaing.edu.co

# Primer admin (se crea al arrancar si no existe)
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=info
